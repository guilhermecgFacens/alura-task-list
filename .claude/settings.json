  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-agents-md.mjs\"",
            "timeout": 30,
            "statusMessage": "Checando AGENTS.md..."
          }
        ]
      }
    ]
